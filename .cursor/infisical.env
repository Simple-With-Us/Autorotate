# Cursor cloud environment configuration for Autorotate.
# Read by scripts/cursor-cloud-start.sh.
#
# Non-secret project metadata for the Autorotate Infisical project.
# INFISICAL_CLIENT_ID and INFISICAL_CLIENT_SECRET are NEVER committed —
# they are added to the Cursor dashboard as org-wide secrets and injected
# into the cloud agent at runtime.

INFISICAL_PROJECT_ID=de442a10-adc1-47c1-88a2-fbc980f8a8df
INFISICAL_ENV=dev
INFISICAL_DOMAIN=https://app.infisical.com
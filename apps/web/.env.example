# ── Autorotate web app environment ──────────────────────────────────
# Copy to .env and fill in real values. NEVER commit a real .env.

# ── Database ─────────────────────────────────────────────────────
# MySQL connection string used by Drizzle ORM.
DATABASE_URL=mysql://user:password@localhost:3306/autorotate

# ── Autorotate backend ──────────────────────────────────────────────
# Console admin token. REQUIRED in production — the server refuses to start
# without it, because the console has no other credential. In development an
# ephemeral token is minted and printed at boot when this is unset.
# Generate with: openssl rand -hex 32
AUTOROTATE_ADMIN_TOKEN=

# Demo mode. OFF unless this is exactly "1" or "true" — anything else
# (including unset, "" and "0") runs real rotations against real providers.
AUTOROTATE_DEMO=0

# 32-byte hex key used to encrypt stored credentials at rest.
# REQUIRED in production; without it the development passphrase published in
# this repository would protect your connector admin credentials.  Leave this
# BLANK and generate a real key — a placeholder key (e.g. all zeros) is a valid
# AES key and is rejected at startup, so committing one is never safe.
# Generate with: openssl rand -hex 32
AUTOROTATE_ENC_KEY=

# Filesystem root for file-based rotation targets.
AUTOROTATE_FILE_ROOT=./autorotate-files

# Run the rotation scheduler outside production. Off by default so a laptop
# pointed at a shared database does not rotate production secrets.
AUTOROTATE_SCHEDULER=0

# ── Platform ─────────────────────────────────────────────────────
APP_ID=your-app-id
APP_SECRET=your-app-secret
VITE_APP_ID=your-app-id

# ── Sentry (optional; unset = inert in dev/CI) ───────────────────
# Public browser DSN.  Never put a server-only DSN here — it is inlined
# into the Vite client bundle.  Session replay defaults to 0 (secrets app);
# errors still capture at 100%.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
# Node SDK for the rotation scheduler + rotation.success/fail metrics.
# Falls back to VITE_SENTRY_DSN when unset.
SENTRY_DSN=

# Release tag applied to every event (client + server).  Auto-derived at
# build time from VERCEL_GIT_COMMIT_SHA / SOURCE_COMMIT / GITHUB_SHA / a
# local `git rev-parse HEAD` / the package version — leave unset, this is
# only here as an explicit override.
# SENTRY_RELEASE=

# ── Sentry source-map upload (optional; unset = no upload, no-op) ──
# All three unset means `npm run build` is byte-for-byte the same as before
# this was added.  Set SENTRY_AUTH_TOKEN (a project-scoped Sentry auth token,
# never a DSN) to turn on @sentry/vite-plugin's source-map upload for the
# `apps/web/dist/public` client bundle; maps are deleted from dist after
# upload so they are never served publicly.  SENTRY_ORG/SENTRY_PROJECT
# default to simple-with-us/autorotate-web (the same project VITE_SENTRY_DSN
# reports events into) and only need overriding for a different target.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=simple-with-us
SENTRY_PROJECT=autorotate-web
